; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3D Multiplayer Template"
config/description="Transport-agnostic 3D multiplayer starter with LAN, direct IP, and optional Steam lobbies"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[autoload]

DebugLogger="*res://addons/debug_manager/DebugLogger.tscn"
SettingsManager="*res://addons/SettingsManager/SettingsManager.tscn"
InputRemapManager="*res://addons/InputRemapManager/InputRemapManager.tscn"
DevConsoleManager="*res://addons/dev_console/DevConsoleManager.tscn"
Session="*res://Scripts/Network/SessionManager.cs"
PlayerIdentityService="*res://Scripts/Network/PlayerIdentityService.cs"
MatchSceneCoordinator="*res://Scripts/Network/MatchSceneCoordinator.cs"
NetworkClock="*res://Scripts/Network/NetworkClock.cs"
ConnectionQuality="*res://Scripts/Network/ConnectionQualityMonitor.cs"
LocalInputContext="*res://Scripts/UI/LocalInputContext.cs"
TextChat="*res://Scripts/Communication/TextChatManager.cs"
PositionalVoiceChat="*res://Scripts/Communication/PositionalVoiceChat.cs"
PlayerList="*res://Scripts/UI/PlayerListPanel.cs"
ExpressionWheels="*res://Scripts/UI/ExpressionWheels.cs"
InteractionManager="*res://Scripts/Interaction/InteractionManager.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="MultiplayerTemplate"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_manager/plugin.cfg")

