<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MultiplayerTemplate.Tests/**/*.cs" />
    <!-- Git worktrees and agent scratch live under .claude/. A worktree there holds a
         second full copy of this project; without this exclusion the editor build sees
         every class twice and stops compiling, and Godot then reports every script as
         "class could not be found". -->
    <Compile Remove=".claude/**/*.cs" />
    <Compile Remove=".worktrees/**/*.cs" />
  </ItemGroup>
</Project>
